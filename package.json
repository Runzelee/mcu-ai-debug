{
  "name": "mcu-debug-monorepo",
  "private": true,
  "author": "Runze Lee <lhx060906@gmail.com>",
  "workspaces": [
    "packages/shared",
    "packages/mcu-debug",
    "packages/mcu-debug-proxy",
    "packages/mcu-debug/src/webviews/cockpit"
  ],
  "scripts": {
    "watch": "npm run watch --workspaces --if-present",
    "build": "npm run version:sync && npm run build --workspaces --if-present",
    "compile": "npm run version:sync && npm run compile --workspaces --if-present",
    "check:shared-package:exports": "node scripts/check-shared-package-exports.js",
    "check:shared-package": "npm run compile --workspace=packages/shared && npm run check:shared-package:exports && npm run update-commit-hash --workspace=packages/mcu-debug && npm run check-types --workspace=packages/mcu-debug && npm run check-types --workspace=packages/mcu-debug-proxy",
    "version:sync": "node ./scripts/sync-versions.js",
    "build:rust:dev": "npm run build:rust:dev --workspace=packages/mcu-debug",
    "build:rust:prod": "npm run build:rust:prod --workspace=packages/mcu-debug",
    "build:extensions": "node scripts/sync-versions.js && npm run build --workspace=packages/mcu-debug --workspace=packages/mcu-debug-proxy",
    "package": "node scripts/package-extensions.js --local",
    "test": "npm run test --workspaces --if-present",
    "test:rust": "node scripts/test-rust.js",
    "lint:rust": "cargo clippy --manifest-path packages/mdbg/Cargo.toml --all-targets -- -D warnings",
    "audit:rust": "cargo audit --file packages/mdbg/Cargo.lock",
    "postinstall": "npm run build-cockpit --workspace=packages/mcu-debug",
    "lint:rust:win": "cargo clippy --manifest-path packages/mdbg/Cargo.toml --lib --target x86_64-pc-windows-gnu -- -D warnings",
    "lint:rust:linux": "cargo clippy --manifest-path packages/mdbg/Cargo.toml --lib --target x86_64-unknown-linux-musl -- -D warnings",
    "lint:rust:all": "npm run lint:rust && npm run lint:rust:win && npm run lint:rust:linux",
    "fmt:rust": "cargo fmt --manifest-path packages/mdbg/Cargo.toml",
    "fmt:rust:check": "cargo fmt --manifest-path packages/mdbg/Cargo.toml -- --check",
    "publish": "node scripts/release-help.js",
    "publish:dryrun": "node scripts/release-help.js",
    "push-artifacts": "node scripts/sync-artifacts.mjs --push",
    "pull-artifacts": "node scripts/sync-artifacts.mjs --pull",
    "run-extensions": "node scripts/run-artifacts.mjs",
    "release": "node scripts/release-help.js",
    "package:local": "node scripts/package-extensions.js --local",
    "package:unified": "node scripts/package-extensions.js --unified",
    "verify:vsix": "node scripts/verify-vsix.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "typescript": "6.0.3",
    "typescript-strict-plugin": "^2.4.4",
    "yauzl": "^3.2.0"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.44",
    "@vscode/vsce": "^3.9.1",
    "fast-uri": "^3.1.6"
  }
}
